# Copy to a PRIVATE local .env file, edit, inspect, then source manually.
# This file contains paths only; NEVER put credentials here.
# These /var/apps aliases must be verified by scripts/inspect.py first.
APP_USER=trim.openclaw
APP_ROOT=/var/apps/trim.openclaw/target
DATA_ROOT=/var/apps/trim.openclaw/home/data
INSTALL_DIR=/var/apps/trim.openclaw/home/data/openclaw
APP_HOME=/var/apps/trim.openclaw/home/data/home
STATE_DIR=/var/apps/trim.openclaw/home/data/home/.openclaw
NODE_BIN=/var/apps/trim.openclaw/home/data/home/.openclaw/tools/cli-node/tools/node/bin/node
BUN_BIN=/var/apps/bunjs/target/bin/bun
LOG_PARENT=/var/apps/trim.openclaw/tmp
# Exact versions are chosen by the operator; no automatic latest target.
# TARGET_VERSION=2026.10.5
# CHECKPOINT_RECEIPT=/private/new-application-readable-directory/receipt.json
